# ==========================================================
#  Pashpashuk Marketplace Bot - Environment Variables
# ==========================================================

# --- Telegram ---
# מ-@BotFather
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# שם המשתמש של הבוט ללא @ (נדרש ל-deep links של כפתורי הערוץ)
BOT_USERNAME=PashpashukBot

# מזהה ערוץ הפרסומים (הבוט חייב להיות אדמין בערוץ).
# אפשר -1001234567890 או @channelusername
CHANNEL_ID=-1001234567890
# קישור ציבורי לערוץ (לכפתור "מעבר לערוץ")
CHANNEL_URL=https://t.me/your_channel

# קבוצת האדמינים שאליה נשלחות מודעות לאישור (הבוט חייב להיות בקבוצה)
ADMIN_GROUP_ID=-1009876543210

# מזהי טלגרם של האדמינים, מופרדים בפסיק
ADMIN_IDS=123456789,987654321

# שם משתמש לתמיכה (ללא @)
SUPPORT_USERNAME=YourSupportUser

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Settings -> API -> service_role (secret). חובה service_role ולא anon.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# --- Webhook (Vercel / Option A) ---
# הדומיין הציבורי של הפרויקט, ללא סלאש בסוף
PUBLIC_URL=https://your-project.vercel.app
# סיסמת אבטחה שרירותית (32+ תווים) לאימות בקשות טלגרם + הפעלת ה-setup
WEBHOOK_SECRET=change_me_to_a_long_random_string_1234567890

# --- Runtime ---
# polling = Hugging Face Spaces / Railway / מקומי | webhook = Vercel
MODE=polling
PORT=7860
